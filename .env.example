PORT=3001

# ── HackerRank Credentials (Multi-credential pool) ──────────────────────────
# Add numbered pairs to distribute scraping load across multiple accounts.
# Each account handles a partition of users, reducing per-account rate-limit pressure.
# The scraper authenticates all credentials in parallel at job start.
#
# Option A: Multiple credentials (recommended for 50+ users per contest)
HACKERRANK_EMAIL_1=admin1@company.com
HACKERRANK_PASSWORD_1=your-password-1
HACKERRANK_EMAIL_2=admin2@company.com
HACKERRANK_PASSWORD_2=your-password-2
# HACKERRANK_EMAIL_3=admin3@company.com
# HACKERRANK_PASSWORD_3=your-password-3
#
# Option B: Single credential (fallback / small user counts)
# HACKERRANK_EMAIL=admin@company.com
# HACKERRANK_PASSWORD=your-password

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Security ─────────────────────────────────────────────────────────────────
API_KEY=your-secret-api-key
